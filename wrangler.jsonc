{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qxt-funded",
  "compatibility_date": "2026-08-07",
  "routes": [
    { "pattern": "qxtfunded.com", "custom_domain": true },
    { "pattern": "www.qxtfunded.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
